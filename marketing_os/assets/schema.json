{
  "schema": "mos.business-repo.v1",
  "version": 1,
  "required_directories": [
    ".mos",
    "business",
    "business/brand",
    "business/brand/assets",
    "business/audience",
    "business/offers",
    "business/strategy",
    "business/proof",
    "business/operations",
    "business/decisions",
    "knowledge",
    "knowledge/sources",
    "knowledge/wiki",
    "content",
    "campaigns",
    "reporting",
    "outputs",
    "archive"
  ],
  "required_files": [
    ".mos/config.yaml",
    ".gitignore",
    "BRAIN.md",
    "CONTEXT.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CONTRACT.md",
    "business/brand/brand.md",
    "business/brand/voice.md",
    "business/audience/primary.md",
    "business/strategy/strategy.md",
    "business/strategy/goals.md",
    "business/strategy/roadmap.md",
    "business/proof/testimonials.md",
    "knowledge/wiki/_index.md",
    "knowledge/wiki/_log.md"
  ],
  "allowed_top_level": [
    "business",
    "knowledge",
    "content",
    "campaigns",
    "reporting",
    "outputs",
    "archive"
  ],
  "context_files": {
    "brand": "business/brand/brand.md",
    "voice": "business/brand/voice.md",
    "audience": "business/audience/primary.md",
    "strategy": "business/strategy/strategy.md",
    "proof": "business/proof/testimonials.md"
  },
  "excluded_from_grounding": [
    "archive"
  ],
  "generated_files": [
    "_index.md"
  ],
  "frontmatter_contract": {
    "required_keys": [
      "title",
      "type",
      "description",
      "date",
      "status"
    ],
    "connective_keys": [
      "sources",
      "related",
      "produced_by"
    ],
    "types": [
      "business",
      "knowledge",
      "source",
      "decision",
      "content",
      "campaign",
      "report",
      "output",
      "reference"
    ],
    "folder_types": {
      "business": "business",
      "business/decisions": "decision",
      "knowledge/sources": "source",
      "knowledge/wiki": "knowledge",
      "content": "content",
      "campaigns": "campaign",
      "reporting": "report",
      "outputs": "output"
    },
    "sources_required_in": [
      "content",
      "campaigns",
      "reporting",
      "outputs"
    ],
    "exempt_names": [
      "BRAIN.md",
      "CONTEXT.md",
      "README.md",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTRACT.md",
      "_index.md",
      "_log.md"
    ],
    "exempt_suffixes": [
      ".excalidraw.md"
    ],
    "statuses": [
      "draft",
      "active",
      "archived",
      "superseded"
    ]
  }
}
